{
  "name": "pirc",
  "version": "0.3.0",
  "private": true,
  "description": "Private, forward-authenticated web client for persistent coding-agent sessions",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @pirc/gateway dev",
    "dev:node": "bun run --filter @pirc/gateway dev:node",
    "dev:web": "bun run --filter @pirc/web dev",
    "build": "bun run --filter @pirc/web build && bun run --filter @pirc/gateway build",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun run --filter \"*\" test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:check": "bun scripts/version.ts check",
    "version:bump": "bun scripts/version.ts bump",
    "check": "bun run version:check && bun run format:check && bun run typecheck && bun run test && bun run build && bun run test:compiled",
    "dev:chat": "bun run --filter @pirc/gateway dev:chat",
    "test:compiled": "bun run --filter @pirc/gateway test:compiled"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@anthropic-ai/sandbox-runtime@0.0.78": "patches/@anthropic-ai%2Fsandbox-runtime@0.0.78.patch"
  }
}
