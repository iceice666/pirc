{
  "description": "Password values and masking (browser.ts maskPasswords over passwordValues of every frame), sensitiveField on each kind of field, and on the focused element through a shadow root.",
  "steps": [
    { "op": "goto", "url": "http://{{HOST_A}}/password.html" },
    { "op": "snapshot" },
    { "op": "snapshot", "mask": true },
    { "op": "evaluate", "helper": "passwordValues", "frames": "all" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Username\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Password\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Upper-case type\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Shown password\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"One-time code\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Card\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"API secret\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Passport number\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Notes\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Recovery words\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "textbox \"Secret note\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "checkbox \"Remember password\"" },
    { "op": "evaluate", "helper": "sensitiveField", "target": "button \"Sign in\"" },
    { "op": "evaluate", "helper": "sensitiveField", "frames": "all" },
    { "op": "click", "target": "textbox \"Password\"" },
    { "op": "evaluate", "helper": "sensitiveField", "frames": "all" },
    { "op": "click", "target": "textbox \"Shadow password\"" },
    { "op": "evaluate", "helper": "sensitiveField", "frames": "all" },
    { "op": "click", "target": "textbox \"Username\"" },
    { "op": "evaluate", "helper": "sensitiveField", "frames": "all" },
    { "op": "fill", "target": "textbox \"Shown password\"", "text": "hunter2" },
    { "op": "snapshot", "mask": true },
    { "op": "evaluate", "helper": "pageMarkdown" }
  ]
}
