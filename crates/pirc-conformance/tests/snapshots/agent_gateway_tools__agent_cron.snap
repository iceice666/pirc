                "content"
              ],
              "type": "object"
            }
          },
          {
            "description": "Replace exact text in a file. `oldText` must match exactly once unless `replaceAll` is true. Read the file first.",
            "name": "edit",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "newText": {
                  "type": "string"
                },
                "oldText": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "replaceAll": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "oldText",
                "newText"
              ],
              "type": "object"
            }
          },
          {
            "description": "List a directory (directories end with /).",
            "name": "ls",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Default: workspace root",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          {
            "description": "Search file contents with a JavaScript regular expression. Returns `path:line: text`. Optional `glob` filters files.",
            "name": "grep",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "glob": {
                  "type": "string"
                },
                "ignoreCase": {
                  "type": "boolean"
                },
                "limit": {
                  "description": "Maximum matches (default 200)",
                  "type": "number"
                },
                "path": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                }
              },
              "required": [
                "pattern"
              ],
              "type": "object"
            }
          },
          {
            "description": "Find files by glob pattern (e.g. `**/*.ts`). Skips .git, node_modules, dist, target, result.",
            "name": "find",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Directory to search (default workspace)",
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                }
              },
              "required": [
                "pattern"
              ],
              "type": "object"
            }
          },
          {
            "description": "Run a bash command in the workspace. stdout and stderr are combined. Default timeout 120s (`timeout` in seconds).",
            "name": "bash",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string"
                },
                "timeout": {
                  "description": "Timeout in seconds",
                  "type": "number"
                }
              },
              "required": [
                "command"
              ],
              "type": "object"
            }
          }
        ]
      },
      {
        "messages": [
          {
            "content": "Show the schedule tool",
            "role": "user",
