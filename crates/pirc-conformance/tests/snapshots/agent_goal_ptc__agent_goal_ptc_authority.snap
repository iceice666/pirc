              {
                "arguments": {
                  "code": "const out = [];\nconst ref = async () => { const g = (await tools.call('get_goal', {})).data.goal; return g ? { goal_id: g.id, revision: g.revision } : {}; };\nout.push(await tools.call(\"get_goal\", {}));\nout.push(await tools.call(\"create_goal\", { objective: '  Hard thing\\r\\n', max_goal_rounds: 1 }));\nout.push(await tools.call(\"create_goal\", { objective: 'Another' }));\nout.push(await tools.call(\"update_goal\", { goal_id: 'nope', revision: 1, action: 'pause' }));\nout.push(await tools.call(\"update_goal\", { ...(await ref()), action: 'complete', objective: 'x' }));\nout.push(await tools.call(\"update_goal\", { ...(await ref()), action: 'pause', blocked_reason: 'x' }));\nout.push(await tools.call(\"update_goal\", { ...(await ref()), action: 'resume' }));\nout.push(await tools.call(\"update_goal\", { ...(await ref()), action: 'edit' }));\nreturn JSON.stringify(out.map((r) => r.ok ? { text: r.data.text, goal: r.data.goal, armed: r.data.armed } : { error: r.error }));"
                },
                "id": "c1",
                "name": "ptc",
