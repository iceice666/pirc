                    "type": "string"
                  },
                  "names": {
                    "description": "Capabilities to document in full",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 8,
                    "minItems": 1,
                    "type": "array"
                  },
                  "registryVersion": {
                    "description": "registryVersion you already have; a mismatch fails with StaleContract",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            {
