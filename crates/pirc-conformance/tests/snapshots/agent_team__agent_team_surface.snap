red\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"id\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"description\":\"pending, in_progress or completed\"},\"owner\":{\"type\":\"string\"},\"blockedBy\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"revision\":{\"type\":\"integer\",\"description\":\"Pass as expected_revision to task_update\"},\"blocked\":{\"type\":\"boolean\"},\"ready\":{\"type\":\"boolean\",\"description\":\"pending, unowned and unblocked\"}},\"required\":[\"text\",\"id\",\"subject\",\"description\",\"status\",\"blockedBy\",\"revision\",\"blocked\",\"ready\"],\"additionalProperties\":true},{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"deleted\":{\"type\":\"string\"}},\"required\":[\"text\",\"deleted\"],\"additionalProperties\":false}]},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.task_update({ task_id: \\\"…\\\", action: \\\"…\\\" });\"]}],\"truncated\":false,\"nextCursor\":null}",
