          {
            "content": [
              {
                "text": "{\"registryVersion\":\"<hex16:1>\",\"contractVersion\":1,\"items\":[{\"name\":\"agent_spawn\",\"category\":\"team\",\"uiLabel\":\"Agent spawn\",\"contractVersion\":1,\"description\":\"Start a persistent independent pirc agent session (maximum 4 live children by default) for work that needs follow-up messages, questions or a shared task board; for a single delegated task prefer subagent. Returns immediately after task acceptance, not completion; the child reports to you each time it goes idle. Before final synthesis, read and integrate reports and resolve pending questions; idle and timeout do not prove success. The runtime waits for active workers after a clean turn without polling the model. Do not send redundant acknowledgements for already-read events. Pick the role that fits the work: it fixes the model, thinking level, tools and role instructions, which only the user configures; what the role leaves unset is inherited from the parent. Supply necessary context and file ownership. Costs are incurred by each child.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"pattern\":\"^[a-z][a-z0-9_-]{0,39}$\"},\"task\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":12000},\"role\":{\"type\":\"string\",\"enum\":[\"general\",\"reviewer\"],\"description\":\"Role for the child (default general). Pick the role that fits the work; it sets the model, thinking level, tool allowlist and role instructions:\\n- general: General-purpose agent with the default model and all tools.\\n- reviewer: Reviews changes without editing them. [from this workspace's .pirc/roles; model fake/small-*; thinking low; tools: read, grep]\"},\"cwd\":{\"type\":\"string\",\"description\":\"Existing working directory or worktree inside the workspace or its allowed paths; defaults to parent cwd\"}},\"required\":[\"name\",\"task\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"name\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"description\":\"team or subagent\"},\"status\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"},\"thinking\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"background\":{\"type\":\"boolean\"},\"lastError\":{\"type\":\"string\"},\"activity\":{\"type\":\"string\",\"description\":\"What it is doing now\"}},\"required\":[\"text\",\"name\",\"status\"],\"additionalProperties\":true},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"process\",\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[\"child\"],\"examples\":[\"const result = await tools.agent_spawn({ name: \\\"…\\\", task: \\\"…\\\" });\"]},{\"name\":\"subagent\",\"category\":\"team\",\"uiLabel\":\"Subagent\",\"contractVersion\":1,\"description\":\"Delegate a self-contained task to a one-shot subagent: a fresh pirc agent with its own context window that cannot see this conversation, message you, or ask the user. Give it everything it needs. It returns only its final report, then exits. Foreground (default) waits and returns the report; aborting stops the subagent. background:true returns at once and delivers the report to you when it finishes (do not poll; keep working or end your turn). The runtime waits for active workers after a clean turn; read and integrate reports before final synthesis, and report failures or pending work honestly. Pick the role that fits the work: it fixes the model, thinking level, tools and role instructions, which only the user configures. Use agent_spawn instead for persistent collaborators that need messages or a task board.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"task\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":12000},\"name\":{\"type\":\"string\",\"pattern\":\"^[a-z][a-z0-9_-]{0,39}$\",\"description\":\"Optional unique name; generated when omitted\"},\"background\":{\"type\":\"boolean\",\"description\":\"Run concurrently (default false)\"},\"role\":{\"type\":\"string\",\"enum\":[\"general\",\"reviewer\"],\"description\":\"Role for the child (default general). Pick the role that fits the work; it sets the model, thinking level, tool allowlist and role instructions:\\n- general: General-purpose agent with the default model and all tools.\\n- reviewer: Reviews changes without editing them. [from this workspace's .pirc/roles; model fake/small-*; thinking low; tools: read, grep]\"},\"cwd\":{\"type\":\"string\",\"description\":\"Existing working directory or worktree inside the workspace or its allowed paths; defaults to parent cwd\"}},\"required\":[\"task\"],\"additionalProperties\":false},\"resultSchema\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"name\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"done\",\"failed\",\"stopped\"]},\"result\":{\"type\":\"string\"},\"error\":{\"type\":\"string\"},\"event_id\":{\"type\":\"string\",\"description\":\"Read the whole result with agent_inbox event_id\"}},\"required\":[\"text\",\"name\",\"status\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"name\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"note\":{\"type\":\"string\"}},\"required\":[\"text\",\"name\",\"status\",\"note\"],\"additionalProperties\":true}]},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"process\",\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[\"child\"],\"examples\":[\"const result = await tools.subagent({ task: \\\"…\\\" });\"]},{\"name\":\"agent_stop\",\"category\":\"team\",\"uiLabel\":\"Agent stop\",\"contractVersion\":1,\"description\":\"Stop a child process and its process group. Session and team history remain on disk.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"}},\"required\":[\"agent\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"stopped\":{\"type\":\"string\"}},\"required\":[\"text\",\"stopped\"],\"additionalProperties\":false},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.agent_stop({ agent: \\\"…\\\" });\"]},{\"name\":\"agent_list\",\"category\":\"team\",\"uiLabel\":\"Agent list\",\"contractVersion\":1,\"description\":\"List team members, process states, session files and archive directory.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"required\":[],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"directory\":{\"type\":\"string\"},\"roles\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"}},\"required\":[\"name\"],\"additionalProperties\":true}},\"agents\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"description\":\"team or subagent\"},\"status\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"},\"thinking\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"background\":{\"type\":\"boolean\"},\"lastError\":{\"type\":\"string\"},\"activity\":{\"type\":\"string\",\"description\":\"What it is doing now\"}},\"required\":[\"name\",\"status\"],\"additionalProperties\":true}}},\"required\":[\"text\",\"directory\",\"roles\",\"agents\"],\"additionalProperties\":false},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"read\"],\"concurrency\":\"read\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.agent_list({});\"]},{\"name\":\"agent_wait\",\"category\":\"team\",\"uiLabel\":\"Agent wait\",\"contractVersion\":1,\"description\":\"Wait without polling for a worker to become idle. Returns early for questions/blocking, stop, failure or timeout. Timeout in seconds (default 60, max 86400). Abort cancels only the wait, not the worker. Cannot wait on yourself or parent; cycles are rejected. Idle is not proof of task success.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":40},\"timeout\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"maximum\":86400}},\"required\":[\"agent\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"agent\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\",\"description\":\"Why the wait ended: a status, question, cancelled, timeout, …\"},\"status\":{\"type\":\"string\"},\"question_id\":{\"type\":\"string\"},\"question_to\":{\"type\":\"string\"},\"sessionFile\":{\"type\":\"string\"}},\"required\":[\"text\",\"agent\",\"reason\",\"status\"],\"additionalProperties\":false},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"read\"],\"concurrency\":\"read\",\"approval\":\"none\",\"suspension\":[\"child\"],\"examples\":[\"const result = await tools.agent_wait({ agent: \\\"…\\\" });\"]},{\"name\":\"agent_send\",\"category\":\"team\",\"uiLabel\":\"Agent send\",\"contractVersion\":1,\"description\":\"Send a peer or parent a message. Wakes idle recipients; queues at tool boundaries when busy. Returns acceptance, not task completion.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"to\":{\"type\":\"string\",\"description\":\"Agent name, or parent\"},\"message\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":12000}},\"required\":[\"to\",\"message\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"id\":{\"type\":\"string\"},\"time\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"description\":\"message, question, reply, post, task, result, …\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"truncated\":{\"type\":\"boolean\",\"description\":\"body is cut; read the event with agent_inbox event_id\"}},\"required\":[\"text\",\"id\",\"time\",\"kind\"],\"additionalProperties\":true},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.agent_send({ to: \\\"…\\\", message: \\\"…\\\" });\"]}],\"truncated\":true,\"nextCursor\":null,\"remaining\":[\"agent_ask\",\"agent_reply\"]}",
