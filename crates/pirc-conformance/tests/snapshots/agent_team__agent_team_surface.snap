          {
            "content": [
              {
                "text": "{\"registryVersion\":\"<hex16:1>\",\"contractVersion\":1,\"items\":[{\"name\":\"agent_inbox\",\"category\":\"team\",\"uiLabel\":\"Agent inbox\",\"contractVersion\":1,\"description\":\"Read sent/received team history, paginated, at most 40KB. Use next as after. Fully returned events suppress duplicate queued parent notifications once this tool result enters context. Truncated entries are previews: pass event_id (and offset, starting from next_offset) to read one event body in 12000-character chunks until next_offset is null. Does not wake agents.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"after\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":50},\"event_id\":{\"type\":\"string\",\"description\":\"Read this one event instead of a page\"},\"offset\":{\"type\":\"integer\",\"minimum\":0,\"description\":\"With event_id: first body character to return (default 0)\"}},\"required\":[],\"additionalProperties\":false},\"resultSchema\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"time\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"description\":\"message, question, reply, post, task, result, …\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"truncated\":{\"type\":\"boolean\",\"description\":\"body is cut; read the event with agent_inbox event_id\"}},\"required\":[\"id\",\"time\",\"kind\"],\"additionalProperties\":true}},\"next\":{\"type\":[\"string\",\"null\"],\"description\":\"Cursor for after\"},\"more\":{\"type\":\"boolean\"},\"archive\":{\"type\":\"string\",\"description\":\"Path of the full event log\"}},\"required\":[\"text\",\"items\",\"next\",\"more\",\"archive\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"event\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"offset\":{\"type\":\"integer\"},\"total_chars\":{\"type\":\"integer\"},\"next_offset\":{\"type\":[\"integer\",\"null\"]}},\"required\":[\"id\",\"body\",\"offset\",\"total_chars\",\"next_offset\"],\"additionalProperties\":true}},\"required\":[\"text\",\"event\"],\"additionalProperties\":false}]},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"read\"],\"concurrency\":\"read\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.agent_inbox({});\"]},{\"name\":\"board_post\",\"category\":\"team\",\"uiLabel\":\"Board post\",\"contractVersion\":1,\"description\":\"Append a shared team note. Does not notify or wake others; use agent_send for urgent updates.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"topic\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":100},\"body\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":12000},\"reply_to\":{\"type\":\"string\"}},\"required\":[\"topic\",\"body\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"id\":{\"type\":\"string\"},\"time\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"description\":\"message, question, reply, post, task, result, …\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"truncated\":{\"type\":\"boolean\",\"description\":\"body is cut; read the event with agent_inbox event_id\"}},\"required\":[\"text\",\"id\",\"time\",\"kind\"],\"additionalProperties\":true},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.board_post({ topic: \\\"…\\\", body: \\\"…\\\" });\"]},{\"name\":\"board_read\",\"category\":\"team\",\"uiLabel\":\"Board read\",\"contractVersion\":1,\"description\":\"Read shared notes, oldest first, paginated at most 40KB. Use next as after with the same topic filter.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"topic\":{\"type\":\"string\"},\"after\":{\"type\":\"string\"},\"limit\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":50}},\"required\":[],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"items\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"time\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"description\":\"message, question, reply, post, task, result, …\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"truncated\":{\"type\":\"boolean\",\"description\":\"body is cut; read the event with agent_inbox event_id\"}},\"required\":[\"id\",\"time\",\"kind\"],\"additionalProperties\":true}},\"next\":{\"type\":[\"string\",\"null\"],\"description\":\"Cursor for after\"},\"more\":{\"type\":\"boolean\"},\"archive\":{\"type\":\"string\",\"description\":\"Path of the full event log\"}},\"required\":[\"text\",\"items\",\"next\",\"more\",\"archive\"],\"additionalProperties\":false},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"read\"],\"concurrency\":\"read\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.board_read({});\"]},{\"name\":\"task_create\",\"category\":\"team\",\"uiLabel\":\"Task create\",\"contractVersion\":1,\"description\":\"Create a pending, unowned task on the shared team task board. blocked_by lists task IDs that must be completed first. Does not notify anyone.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200},\"description\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":12000},\"blocked_by\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"maxItems\":50}},\"required\":[\"subject\",\"description\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"id\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"description\":\"pending, in_progress or completed\"},\"owner\":{\"type\":\"string\"},\"blockedBy\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"revision\":{\"type\":\"integer\",\"description\":\"Pass as expected_revision to task_update\"},\"blocked\":{\"type\":\"boolean\"},\"ready\":{\"type\":\"boolean\",\"description\":\"pending, unowned and unblocked\"}},\"required\":[\"text\",\"id\",\"subject\",\"description\",\"status\",\"blockedBy\",\"revision\",\"blocked\",\"ready\"],\"additionalProperties\":true},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.task_create({ subject: \\\"…\\\", description: \\\"…\\\" });\"]},{\"name\":\"task_list\",\"category\":\"team\",\"uiLabel\":\"Task list\",\"contractVersion\":1,\"description\":\"List shared tasks with status, owner, revision, blocked_by and readiness (pending, unowned, all dependencies completed). Filter by status, owner (\\\"unowned\\\" for none) or ready.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"in_progress\",\"completed\"]},\"owner\":{\"type\":\"string\",\"maxLength\":40},\"ready\":{\"type\":\"boolean\"}},\"required\":[],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"tasks\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"description\":\"pending, in_progress or completed\"},\"owner\":{\"type\":\"string\"},\"blockedBy\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"revision\":{\"type\":\"integer\",\"description\":\"Pass as expected_revision to task_update\"},\"blocked\":{\"type\":\"boolean\"},\"ready\":{\"type\":\"boolean\",\"description\":\"pending, unowned and unblocked\"}},\"required\":[\"id\",\"subject\",\"description\",\"status\",\"blockedBy\",\"revision\",\"blocked\",\"ready\"],\"additionalProperties\":true}}},\"required\":[\"text\",\"tasks\"],\"additionalProperties\":false},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"read\"],\"concurrency\":\"read\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.task_list({});\"]},{\"name\":\"task_get\",\"category\":\"team\",\"uiLabel\":\"Task get\",\"contractVersion\":1,\"description\":\"Read one shared task, including its current revision, before changing it.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"task_id\":{\"type\":\"string\"}},\"required\":[\"task_id\"],\"additionalProperties\":false},\"resultSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"id\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"description\":\"pending, in_progress or completed\"},\"owner\":{\"type\":\"string\"},\"blockedBy\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"revision\":{\"type\":\"integer\",\"description\":\"Pass as expected_revision to task_update\"},\"blocked\":{\"type\":\"boolean\"},\"ready\":{\"type\":\"boolean\",\"description\":\"pending, unowned and unblocked\"}},\"required\":[\"text\",\"id\",\"subject\",\"description\",\"status\",\"blockedBy\",\"revision\",\"blocked\",\"ready\"],\"additionalProperties\":true},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"read\"],\"concurrency\":\"read\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.task_get({ task_id: \\\"…\\\" });\"]},{\"name\":\"task_update\",\"category\":\"team\",\"uiLabel\":\"Task update\",\"contractVersion\":1,\"description\":\"Change a shared task. Actions: claim (pending, unblocked, unowned or assigned to you → in_progress, owned by you), release, complete (owner or parent), reopen, edit (subject/description), set_dependencies (blocked_by), assign (parent only; owner = teammate name, empty to unassign; notifies the teammate), delete (parent only). Pass expected_revision from task_get/task_list to avoid overwriting a concurrent change. Tasks owned by a member that stops are released.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"task_id\":{\"type\":\"string\"},\"action\":{\"type\":\"string\",\"enum\":[\"claim\",\"release\",\"complete\",\"reopen\",\"edit\",\"set_dependencies\",\"assign\",\"delete\"]},\"expected_revision\":{\"type\":\"integer\",\"minimum\":0},\"subject\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":200},\"description\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":12000},\"blocked_by\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"maxItems\":50},\"owner\":{\"type\":\"string\",\"maxLength\":40}},\"required\":[\"task_id\",\"action\"],\"additionalProperties\":false},\"resultSchema\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\",\"description\":\"The formatted output (what a person reading the result would see)\"},\"images\":{\"type\":\"array\",\"description\":\"Images the operation returned, kept by the host: pass one to attachments.add() to show it to the model with the ptc result\",\"items\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"string\",\"description\":\"Opaque attachment handle\"},\"mimeType\":{\"type\":\"string\"},\"bytes\":{\"type\":\"integer\"}},\"req