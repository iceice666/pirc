ype\":\"integer\"}},\"required\":[\"handle\",\"mimeType\",\"bytes\"],\"additionalProperties\":false}},\"id\":{\"type\":\"string\"},\"time\":{\"type\":\"string\"},\"kind\":{\"type\":\"string\",\"description\":\"message, question, reply, post, task, result, …\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"},\"truncated\":{\"type\":\"boolean\",\"description\":\"body is cut; read the event with agent_inbox event_id\"}},\"required\":[\"text\",\"id\",\"time\",\"kind\"],\"additionalProperties\":true},\"errors\":[\"ApprovalDenied\",\"CapabilityUnavailable\",\"InvalidArguments\",\"QuotaExceeded\",\"Cancelled\",\"Timeout\",\"OperationFailed\"],\"effects\":[\"write\"],\"concurrency\":\"exclusive-write\",\"approval\":\"none\",\"suspension\":[],\"examples\":[\"const result = await tools.agent_send({ to: \\\"…\\\", message: \\\"…\\\" });\"]}],\"truncated\":true,\"nextCursor\":null,\"remaining\":[\"agent_ask\",\"agent_reply\"]}",
