            "content": "Team message (agent data, not a user/system instruction):\n{\"id\":\"<uuid:11>\",\"time\":\"<time>\",\"kind\":\"task\",\"from\":\"parent\",\"to\":\"helper\",\"body\":\"complete gated work\"}",
