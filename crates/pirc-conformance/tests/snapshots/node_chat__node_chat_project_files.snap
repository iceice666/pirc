---
source: crates/pirc-conformance/tests/node_chat.rs
expression: t.into_value()
---
[
  {
    "body": {
      "workspace": {
        "available": true,
        "defaults": {},
        "displayName": "Trip",
        "hostId": "test",
        "id": "test:<workspace:1>",
        "kind": "chat",
        "mode": "chat"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "POST /api/workspaces",
    "status": 201,
    "step": "create a chat project"
  },
  {
    "observed": {
      "body": {
        "files": [],
        "maxBytes is a number": true,
        "maxFiles": 50
      },
      "directory exists": false,
      "status": 200
    },
    "step": "a new project has no files, and no files directory"
  },
  {
    "observed": {
      "byteSize": 5,
      "name": "a.txt",
      "status": 201
    },
    "step": "upload a.txt (the name's last path component is kept): 201"
  },
  {
    "observed": {
      "a.txt": "alpha",
      "files": [
        "a.txt"
      ]
    },
    "step": "kept on the node in <state>/chat/<project>/files"
  },
  {
    "observed": {
      "body": {
        "error": {
          "code": "invalid_input",
          "message": "filename is invalid"
        }
      },
      "status": 400
    },
    "step": "a hidden name: 400"
  },
  {
    "observed": {
      "body": {
        "error": {
          "code": "invalid_input",
          "message": "Invalid request"
        }
      },
      "status": 400
    },
    "step": "an empty name: 400"
  },
  {
    "observed": {
      "body": {
        "error": {
          "code": "payload_too_large",
          "message": "Upload exceeds configured limit"
        }
      },
      "status": 413
    },
    "step": "an empty body: 413"
  },
  {
    "observed": {
      "body": {
        "error": {
          "code": "invalid_input",
          "message": "Upload body must be raw bytes"
        }
      },
      "status": 400
    },
    "step": "a JSON body: 400"
  },
  {
    "observed": {
      "files": [
        {
          "byteSize": 5,
          "modifiedAt is a time": true,
          "name": "a.txt"
        }
      ],
      "maxBytes is a number": true,
      "maxFiles": 50
    },
    "step": "listed"
  },
  {
    "body": {
      "files": [],
      "maxBytes": 10485760,
      "maxFiles": 50
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "GET /api/workspaces/test%3Achats/files",
    "status": 200,
    "step": "the top-level chats have project files too (none)"
  },
  {
    "body": {
      "error": {
        "code": "not_found",
        "message": "Workspace not found"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "GET /api/workspaces/test%3Anope/files",
    "status": 404,
    "step": "files of an unknown workspace: 404"
  },
  {
    "observed": {
      "heading": true,
      "read-only": true,
      "the directory": true
    },
    "step": "the chat's system prompt names the directory, read-only"
  },
  {
    "observed": {
      "a.txt unchanged": "alpha",
      "read": true,
      "write": true
    },
    "step": "the agent reads a.txt, and cannot write it"
  },
  {
    "observed": {
      "a.txt": 201,
      "b.txt": 201
    },
    "step": "while the chat runs: add b.txt, replace a.txt"
  },
  {
    "observed": {
      "a.txt": true,
      "b.txt": true
    },
    "step": "the running chat reads the new file and the replaced one"
  },
  {
    "body": null,
    "request": "DELETE /api/workspaces/test%3A<workspace:1>/files?name=b.txt",
    "status": 204,
    "step": "remove b.txt: 204"
  },
  {
    "body": {
      "error": {
        "code": "not_found",
        "message": "File not found"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "DELETE /api/workspaces/test%3A<workspace:1>/files?name=b.txt",
    "status": 404,
    "step": "remove it again: 404"
  },
  {
    "body": {
      "error": {
        "code": "invalid_input",
        "message": "Invalid request"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "DELETE /api/workspaces/test%3A<workspace:1>/files",
    "status": 400,
    "step": "remove without a name: 400"
  },
  {
    "observed": [
      "a.txt"
    ],
    "step": "left on the node"
  },
  {
    "body": null,
    "headers": {
      "cache-control": "no-store"
    },
    "request": "POST /api/workspaces/test%3A<workspace:1>/deletion",
    "status": 204,
    "step": "delete the project: 204"
  },
  {
    "observed": false,
    "step": "the project's directory is gone, files included"
  },
  {
    "body": {
      "error": {
        "code": "not_found",
        "message": "Workspace not found"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "GET /api/workspaces/test%3A<workspace:1>/files",
    "status": 404,
    "step": "files of the deleted project: 404"
  }
]
