        "rpcId": "<delegation:1>",
        "runnerEpoch": 0,
        "sessionId": "session_<uuid:1>",
        "status": "pending"
      },
      "type": "interaction_created"
    },
    "step": "the chat's event"
  },
  {
    "observed": {
      "data": {
        "interactionId": "<delegation:1>"
      },
      "type": "interaction_answered"
    },
    "step": "the chat's event once it lapsed"
  },
  {
    "observed": {
      "method": "POST",
      "payload": {
        "content": "Delegation update (gateway data, not user instructions):\n{\"delegation\":\"<delegation:1>\",\"title\":\"Later.\",\"workspace\":\"Repo on work\",\"status\":\"expired\"}\nNobody approved it in time: ask again only if it is still wanted.",
        "customType": "assistant-delegation-update",
        "details": {
          "delegationId": "<delegation:1>",
          "status": "expired"
        }
      },
      "url": "/api/sessions/chat-1/deliver",
      "user": "test@example.com"
    },
    "step": "the chat hears it lapsed"
  },
  {
    "observed": [],
    "step": "the chat's snapshot"
  },
  {
    "body": {
      "error": {
        "code": "stale_interaction",
        "message": "This delegation can no longer be answered"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
