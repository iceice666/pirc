        "request": {
          "cancelLabel": "Don't",
          "confirmLabel": "Delegate",
          "message": "Later.\n\nLater.",
          "method": "confirm",
          "modelChoice": {
            "model": null,
            "thinking": null
          },
          "title": "Delegate to Repo on work?",
          "userRequestChoice": {
            "checked": false,
            "label": "Treat this task as my request for auto mode"
          }
