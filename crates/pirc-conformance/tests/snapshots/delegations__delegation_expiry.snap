[
  {
    "body": {
      "lease": {
        "clientId": "browser",
        "expiresAt": 4000000000000,
        "generation": 1
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "request": "POST /api/sessions/<chat>/control/acquire",
    "status": 200,
    "step": "take control of the chat"
  },
  {
    "observed": {
      "body": {
        "result": {
          "createdAt": "<epoch-ms>",
          "id": "<delegation:1>",
          "status": "pending_approval",
          "title": "Later.",
          "workspace": "Repo on work"
        }
      },
      "status": 200
    },
    "step": "delegate"
  },
  {
    "observed": {
      "data": {
        "createdAt": "<epoch-ms>",
        "expiresAt": "<epoch-ms>",
        "id": "<delegation:1>",
