                "code": "const out = [];\nlet id;\nconst call = async (args) => {\n  const r = await tools.call(\"background_task\", args);\n  out.push(r.ok ? r.data.text : r.error);\n  if (r.ok && r.data.task && id === undefined) id = r.data.task.id;\n  return r;\n};\nawait call({ action: \"start\", command: \"echo started; sleep 30\" });\nawait call({ action: \"wait\", id, timeout: 0.3 });\nawait call({ action: \"monitor\", id, notify_on: \"a/b\" });\nawait call({ action: \"monitor\", id });\nawait call({ action: \"monitor\", id, notify_on: \"(\" });\nawait call({ action: \"stop\", id });\nawait call({ action: \"stop\", id });\nreturn JSON.stringify(out);"
              },
