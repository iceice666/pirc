            "api": "openai-completions",
            "completedAt": "<epoch-ms>",
            "content": [
              {
                "arguments": {
                  "code": "const out = [];\nlet id;\nconst call = async (args) => {\n  const r = await tools.call(\"background_task\", args);\n  out.push(r.ok ? r.data.text : r.error);\n  if (r.ok && r.data.task && id === undefined) id = r.data.task.id;\n  return r;\n};\nawait call({ action: \"list\" });\nawait call({ action: \"start\", command: \"sleep 0.3; echo hello; pwd; sleep 0.1; echo err >&2\", cwd: \"sub\" });\nawait call({ action: \"list\" });\nawait call({ action: \"wait\", id });\nawait call({ action: \"output\", id });\nawait call({ action: \"output\", id, lines: 1 });\nawait call({ action: \"stop\", id });\nawait call({ action: \"monitor\", id, notify_on: \"x\" });\nawait call({ action: \"write\", id, input: \"x\" });\nreturn JSON.stringify(out);"
                },
                "id": "t1",
                "name": "ptc",
                "type": "toolCall"
              }
            ],
