          "content": [
            {
              "arguments": {
                "code": "const out = [];\nlet id;\nconst call = async (args) => {\n  const r = await tools.call(\"background_task\", args);\n  out.push(r.ok ? r.data.text : r.error);\n  if (r.ok && r.data.task && id === undefined) id = r.data.task.id;\n  return r;\n};\nawait call({ action: \"start\" });\nawait call({ action: \"start\", command: \"   \" });\nawait call({ action: \"start\", command: \"true\", cwd: \"missing\" });\nawait call({ action: \"start\", command: \"true\", cwd: \"sub/file.txt\" });\nawait call({ action: \"start\", command: \"true\", notify_on: \"(\" });\nawait call({ action: \"start\", command: \"true\", notify_on: \"\" });\nawait call({ action: \"start\", command: \"a\\u0000b\" });\nawait call({ action: \"output\" });\nawait call({ action: \"output\", id: \"nope\" });\nawait call({ action: \"wait\", id: \"nope\" });\nawait call({ action: \"write\", id: \"nope\" });\nawait call({ action: \"write\", id: \"nope\", input: \"x\" });\nawait call({ action: \"monitor\", id: \"nope\" });\nawait call({ action: \"stop\", id: \"nope\" });\nawait call({ action: \"frob\" });\nawait call({ action: \"list\", lines: 0 });\nreturn JSON.stringify(out);"
              },
              "id": "t4",
              "name": "ptc",
              "type": "toolCall"
            }
          ],
