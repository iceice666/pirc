            {
              "text": "[{\"code\":\"OperationFailed\",\"message\":\"command is required for start.\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op1\"},{\"code\":\"OperationFailed\",\"message\":\"command is required for start.\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op2\"},{\"code\":\"OperationFailed\",\"message\":\"cwd must be an existing absolute directory\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op3\"},{\"code\":\"OperationFailed\",\"message\":\"cwd must be an existing absolute directory\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op4\"},{\"code\":\"OperationFailed\",\"message\":\"Invalid notify_on pattern: Invalid regular expression: missing )\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op5\"},{\"code\":\"OperationFailed\",\"message\":\"notify_on must be a regular expression of 1–500 characters\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op6\"},{\"code\":\"OperationFailed\",\"message\":\"command must be a nonempty string of at most 16000 characters without NUL characters\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op7\"},{\"code\":\"OperationFailed\",\"message\":\"id is required.\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op8\"},{\"code\":\"OperationFailed\",\"message\":\"Unknown background task: nope\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op9\"},{\"code\":\"OperationFailed\",\"message\":\"Unknown background task: nope\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op10\"},{\"code\":\"OperationFailed\",\"message\":\"input is required for write.\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op11\"},{\"code\":\"OperationFailed\",\"message\":\"Unknown background task: nope\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op12\"},{\"code\":\"OperationFailed\",\"message\":\"Unknown background task: nope\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op13\"},{\"code\":\"OperationFailed\",\"message\":\"Unknown background task: nope\",\"outcome\":\"unknown\",\"operationId\":\"<uuid:29>:op14\"},{\"code\":\"InvalidArguments\",\"message\":\"Invalid arguments for background_task: action must be one of [\\\"start\\\",\\\"list\\\",\\\"output\\\",\\\"wait\\\",\\\"write\\\",\\\"monitor\\\",\\\"stop\\\"]\",\"outcome\":\"not_started\",\"operationId\":\"<uuid:29>:op15\"},{\"code\":\"InvalidArguments\",\"message\":\"Invalid arguments for background_task: lines must be >= 1\",\"outcome\":\"not_started\",\"operationId\":\"<uuid:29>:op16\"}]",
              "type": "text"
            }
