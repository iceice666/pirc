                  "items": {
                    "type": "string"
                  },
                  "maxItems": 8,
                  "minItems": 1,
                  "type": "array"
                },
                "registryVersion": {
                  "description": "registryVersion you already have; a mismatch fails with StaleContract",
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          {
            "description": "Read a file. Text is returned with line numbers (`offset` is 1-based, default limit 2000 lines). Images (png/jpg/gif/webp) are returned as images.",
            "name": "read",
            "parameters": {
              "additionalProperties": false,
              "properties": {
                "limit": {
