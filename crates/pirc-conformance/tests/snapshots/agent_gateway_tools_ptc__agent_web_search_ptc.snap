                  "type": "number"
                },
                "path": {
                  "description": "File path, relative to the workspace or absolute",
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          },
          {
            "description": "Create or overwrite a file with the given content. Parent directories are created.",
