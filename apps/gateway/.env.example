# pirc runs as two processes with separate environments:
#   pirc gateway  browser API and routing; never runs agents
#   pirc node     agents, shells and workspaces of one machine; connects out to the gateway
# On a single machine, run both. Do not commit real tokens.

# ---- gateway ----------------------------------------------------------------

# Listen address (keep private/loopback behind the authenticated proxy)
PIRC_HOST=127.0.0.1
PIRC_PORT=8787
PIRC_STATE_DIR=./.state/gateway

# Exact socket peer addresses allowed to supply the identity header.
PIRC_TRUSTED_PROXIES=127.0.0.1,::1
PIRC_IDENTITY_HEADER=x-pirc-user
PIRC_ALLOWED_USERS=alice@example.com
PIRC_ALLOWED_ORIGINS=https://pirc.example.ts.net
PIRC_ALLOWED_HOSTS=pirc.example.ts.net

# JSON map of node ID to a distinct random secret (at least 32 characters).
# Inject as a secret, e.g. `openssl rand -base64 36`.
PIRC_NODE_TOKENS={"homolab":"replace-with-a-random-secret-of-at-least-32-characters"}

PIRC_EVENT_BUFFER_SIZE=1000
PIRC_WS_MAX_BUFFERED_BYTES=1048576
PIRC_UPLOAD_MAX_BYTES=10485760

# Model providers for every node (keys resolved here, pushed over the node link).
# SIGHUP reloads it; new sessions use the reloaded providers.
# PIRC_MODELS_FILE=~/.config/.pirc/models.json

# ---- node (separate process and environment) ---------------------------------

# PIRC_NODE_ID=homolab
# PIRC_NODE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# wss:// is required unless the gateway is on loopback:
# PIRC_DAEMON_URL=ws://127.0.0.1:8787
# Users allowed to operate this node (normally the same as the gateway's).
# PIRC_ALLOWED_USERS=alice@example.com
# PIRC_STATE_DIR=./.state/node
# JSON array; may be empty, workspaces can also be added from the web.
# PIRC_WORKSPACES=[{"id":"pirc","path":"/srv/src/pirc","displayName":"pirc","defaults":{}}]

# Agent: defaults to re-running this binary as `pirc agent`.
# PIRC_AGENT_COMMAND=/path/to/pirc
# PIRC_AGENT_ARGS=["agent"]
# Node-local agent limits/features/hooks live in $PIRC_CONFIG_DIR/config.json;
# providers come from the gateway.
# PIRC_CONFIG_DIR=~/.config/.pirc
# PIRC_RUNNER_LIMIT=2
# PIRC_LEASE_TTL_MS=30000
# PIRC_INTERACTION_TTL_MS=3600000
# PIRC_RPC_MAX_LINE_BYTES=1048576
# PIRC_RPC_MAX_OUTPUT_BYTES=16777216
# PIRC_SHUTDOWN_GRACE_MS=5000
# Side-panel shells (run as this account in the workspace):
# PIRC_TERMINALS=true
# PIRC_TERMINAL_SHELL=/bin/zsh
