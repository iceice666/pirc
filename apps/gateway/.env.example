# Separate executables and environments:
#   pirc-gateway  browser API and routing; never runs agents
#   pirc-chat     assistant chats/projects; connects out to the gateway
#   pirc-node     coding agents, shells and workspaces; connects out to the gateway
# On one machine, run the gateway and a node, optionally also a chat node.
# Keep distinct IDs/tokens/state directories for each node. Do not commit real tokens.

# ---- gateway ----------------------------------------------------------------

# Listen address (keep private/loopback behind the authenticated proxy)
PIRC_HOST=127.0.0.1
PIRC_PORT=8787
PIRC_STATE_DIR=./.state/gateway

# Exact socket peer addresses allowed to supply the identity header.
PIRC_TRUSTED_PROXIES=127.0.0.1,::1
PIRC_IDENTITY_HEADER=x-pirc-user
PIRC_ALLOWED_USERS=alice@example.com
PIRC_ALLOWED_ORIGINS=https://pirc.example.ts.net
PIRC_ALLOWED_HOSTS=pirc.example.ts.net
# Shared secret the proxy sends as `x-pirc-proxy-secret` (at least 32 characters).
# Without it any local process that can connect from a trusted proxy address can
# claim any allowed user; the gateway warns at startup. Inject as a secret.
# PIRC_PROXY_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# JSON map of node ID to a distinct random secret (at least 32 characters).
# Inject as a secret, e.g. `openssl rand -base64 36`.
PIRC_NODE_TOKENS={"homolab":"replace-with-a-random-secret-of-at-least-32-characters"}

PIRC_EVENT_BUFFER_SIZE=1000
PIRC_WS_MAX_BUFFERED_BYTES=1048576
PIRC_UPLOAD_MAX_BYTES=10485760

# Phone device tokens (see README): days without use, and days after pairing.
PIRC_DEVICE_TOKEN_IDLE_DAYS=7
PIRC_DEVICE_TOKEN_MAX_DAYS=30

# Model providers for every node (keys resolved here; only a secret-free catalog reaches nodes).
# SIGHUP reloads it; running sessions use the reloaded providers on their next request.
# PIRC_MODELS_FILE=~/.config/.pirc/models.json

# ---- chat/coding node (separate process and environment) ---------------------

# PIRC_NODE_ID=homolab
# PIRC_NODE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# wss:// is required unless the gateway is on loopback:
# PIRC_DAEMON_URL=ws://127.0.0.1:8787
# Users allowed to operate this node (normally the same as the gateway's).
# PIRC_ALLOWED_USERS=alice@example.com
# PIRC_STATE_DIR=./.state/node
# pirc-node: JSON array; may be empty, workspaces can also be added from the web.
# pirc-chat: must remain empty; the executable fixes the chat role.
# PIRC_WORKSPACES=[{"id":"pirc","path":"/srv/src/pirc","displayName":"pirc","defaults":{}}]

# Agent: defaults to re-running this node executable with its internal `agent` command.
# PIRC_AGENT_COMMAND=/path/to/pirc-node
# PIRC_AGENT_ARGS=["agent"]
# Node-local agent limits/features/hooks live in $PIRC_CONFIG_DIR/config.json;
# providers come from the gateway.
# PIRC_CONFIG_DIR=~/.config/.pirc
# PIRC_LEASE_TTL_MS=30000
# PIRC_INTERACTION_TTL_MS=3600000
# PIRC_RPC_MAX_LINE_BYTES=1048576
# PIRC_SHUTDOWN_GRACE_MS=5000
# Side-panel shells (run as this account in the workspace):
# PIRC_TERMINALS=true
# PIRC_TERMINAL_SHELL=/bin/zsh
# Agent browser: private/local hosts it may reach anyway (host names, *.suffix,
# IPs, CIDR ranges, or * for all). The gateway's own host stays blocked.
# PIRC_BROWSER_ALLOW_PRIVATE=localhost,127.0.0.1,192.168.1.0/24
# The gateway's public host names, never opened by the agent's browser:
# PIRC_BROWSER_BLOCK_HOSTS=pirc.example.ts.net
# Node-environment variables passed on to agents on purpose:
# PIRC_AGENT_ENV_ALLOW=GITHUB_TOKEN
