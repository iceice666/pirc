# Gateway listen address (keep private/loopback behind the authenticated proxy)
PIRC_HOST=127.0.0.1
PIRC_PORT=8787
PIRC_STATE_DIR=./.state

# Exact socket peer addresses allowed to supply the identity header.
PIRC_TRUSTED_PROXIES=127.0.0.1,::1
PIRC_IDENTITY_HEADER=x-pirc-user
PIRC_ALLOWED_USERS=alice@example.com
PIRC_ALLOWED_ORIGINS=https://pirc.example.ts.net
PIRC_ALLOWED_HOSTS=pirc.example.ts.net

# JSON array. Paths must exist and are canonicalized at startup.
PIRC_WORKSPACES=[{"id":"pirc","path":"/srv/src/pirc","displayName":"pirc","defaults":{}}]
PIRC_HOST_ID=homolab

# Central daemon with no Pi execution: PIRC_DAEMON_ONLY=true, PIRC_WORKSPACES=[]
# Daemon-only: JSON map of node ID to a distinct random token (at least 32 characters).
# Inject as a secret; do not commit real tokens.
# PIRC_NODE_TOKENS={"computer-a":"replace-with-a-random-secret-of-at-least-32-characters"}
# Node-only: use the same token assigned to this ID in PIRC_NODE_TOKENS.
# Also set PIRC_ALLOWED_USERS for every user allowed to operate this node.
# Keep each node's PIRC_STATE_DIR and PIRC_WORKSPACES local to its own machine.
# PIRC_NODE_ID=computer-a
# PIRC_NODE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# PIRC_DAEMON_URL=wss://pirc.example.ts.net

# Agent: defaults to re-running this binary as `pirc agent`.
# PIRC_AGENT_COMMAND=/path/to/pirc
# PIRC_AGENT_ARGS=["agent"]
# Agent providers/models/features live in $PIRC_CONFIG_DIR/config.json.
# PIRC_CONFIG_DIR=~/.config/.pirc
PIRC_RUNNER_LIMIT=2
PIRC_EVENT_BUFFER_SIZE=1000
PIRC_LEASE_TTL_MS=30000
PIRC_INTERACTION_TTL_MS=3600000
PIRC_UPLOAD_MAX_BYTES=10485760
PIRC_RPC_MAX_LINE_BYTES=1048576
PIRC_RPC_MAX_OUTPUT_BYTES=16777216
PIRC_WS_MAX_BUFFERED_BYTES=1048576
PIRC_SHUTDOWN_GRACE_MS=5000

# Development-only explicit opt-in if PIRC_WORKSPACES is omitted:
# PIRC_ALLOW_DEFAULT_WORKSPACE=true
# PIRC_DEFAULT_WORKSPACE=/absolute/path
# PIRC_DEFAULT_WORKSPACE_NAME=Development
