{
  "name": "@pirc/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts gateway",
    "dev:node": "bun --watch src/cli.ts node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun build --compile --minify --sourcemap src/cli.ts --outfile dist/pirc",
    "start": "bun src/cli.ts gateway",
    "start:node": "bun src/cli.ts node",
    "test": "bun test"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3",
    "@types/bun": "^1.2.0"
  },
  "bin": {
    "pirc": "src/cli.ts"
  }
}
