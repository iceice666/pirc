    {
      "id": "number-size-rules",
      "source": "<div><input id=\"number-default\" type=\"number\" value=\"3\"></div><div><input id=\"number-explicit-size-2\" type=\"number\" size=\"2\" value=\"3\"></div><div><input id=\"number-explicit-size-2-bounded\" type=\"number\" size=\"2\" min=\"1\" max=\"9\" step=\"2\" value=\"3\"></div><div><input id=\"number-one-digit-bounds-default-step\" type=\"number\" min=\"1\" max=\"9\" value=\"3\"></div><div><input id=\"number-one-digit-bounds-step-2\" type=\"number\" min=\"1\" max=\"9\" step=\"2\" value=\"3\"></div><div><input id=\"number-fractional-step\" type=\"number\" min=\"0\" max=\"2\" step=\"0.25\" value=\"1.25\"></div><div><input id=\"number-negative-bounds\" type=\"number\" min=\"-9\" max=\"9\" step=\"1\" value=\"0\"></div><div><input id=\"number-negative-fraction-bounds\" type=\"number\" min=\"-1.5\" max=\"2.75\" step=\"0.125\" value=\"0\"></div><div><input id=\"number-step-exponent\" type=\"number\" min=\"1\" max=\"9\" step=\"1e-3\" value=\"1\"></div><div><input id=\"number-step-any\" type=\"number\" min=\"1\" max=\"9\" step=\"any\" value=\"3\"></div><div><input id=\"number-missing-min\" type=\"number\" max=\"9\" step=\"2\" value=\"3\"></div><div><input id=\"number-missing-max\" type=\"number\" min=\"1\" step=\"2\" value=\"3\"></div><div><input id=\"number-invalid-min\" type=\"number\" min=\"not-a-number\" max=\"9\" step=\"2\" value=\"3\"></div><div><input id=\"number-invalid-step-zero\" type=\"number\" min=\"1\" max=\"9\" step=\"0\" value=\"3\"></div><div><input id=\"number-unbounded-negative-step\" type=\"number\" min=\"-1000\" max=\"25\" step=\"-2\" value=\"3\"></div><div><input id=\"number-invalid-step-negative\" type=\"number\" min=\"1\" max=\"9\" step=\"-234\" value=\"3\"></div>"
