  "simulation": {
    "shell": "Pinned production App.svelte, production app.css/markdown.css, and the production index.html app wrappers. A local fetch fixture provides deterministic App bootstrap and workspace settings responses; no external backend or WebSocket is used.",
    "interactions": "Transient reads and writes are captured while the actual settings component's fetch is held pending. Retry, save, trust, and revoke are performed through rendered browser controls.",
    "textScale": "Before every flow step and capture, restore the original font declarations, read every base computed size, then apply a second-pass inline !important multiplier. Actions run with the requested scale; dynamically inserted nodes are scaled without parent/child double scaling. This simulates text sizing, not OS zoom or physical input."
  },
  "workspaces": [
    {
      "id": "home:chats",
      "hostId": "home",
      "displayName": "Chats",
      "kind": "chat",
      "defaults": {}
    },
    {
      "id": "home:trip",
      "hostId": "home",
      "displayName": "Trip planning",
      "kind": "chat",
      "defaults": {
        "modelId": "gpt-5.4",
        "thinkingLevel": "medium"
      }
    },
