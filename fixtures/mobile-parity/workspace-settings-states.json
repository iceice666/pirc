      "expect": {
        "stage": "loading",
        "status": "Loading project instructions\u2026"
      },
      "flow": [
        {
          "type": "waitHeld",
          "withOtherSettingsLoaded": true
        },
        {
          "type": "capture",
          "stage": "loading"
        },
        {
          "type": "releaseHeld"
        },
        {
          "type": "waitIdle"
        },
        {
          "type": "capture",
          "stage": "ready"
        }
      ]
    },
    {
