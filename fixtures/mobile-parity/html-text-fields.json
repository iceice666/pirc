{
  "id": "html-text-fields-v1",
  "webRevision": "bd3d90981271e1f93cf3d1d1a5bbf9b61136b74c",
  "widths": [
    390,
    768
  ],
  "height": 1000,
  "padding": 16,
  "cases": [
    {
      "id": "text-types",
      "source": "<div><label for=\"plain\">Name</label> <input id=\"plain\" value=\"Ada\" placeholder=\"Your name\"></div>\n<div><label for=\"search\">Search</label> <input id=\"search\" type=\"search\" value=\"query\"></div>\n<div><label for=\"email\">Email</label> <input id=\"email\" type=\"email\" value=\"  a@example.com  \"></div>\n<div><label for=\"url\">URL</label> <input id=\"url\" type=\"url\" value=\"  https://example.com  \"></div>\n<div><label for=\"tel\">Phone</label> <input id=\"tel\" type=\"tel\" value=\"+886 123\"></div>\n<div><label for=\"password\">Password</label> <input id=\"password\" type=\"password\" value=\"secret\"></div>\n<div><label for=\"unknown\">Unknown type</label> <input id=\"unknown\" type=\"not-a-type\" value=\"literal\"></div>",
      "actions": [
        {
          "id": "label-focus",
          "selector": "label[for=plain]"
        },
        {
          "id": "edit-name",
          "selector": "#plain",
          "mode": "fill",
          "value": "Grace Hopper"
        },
        {
          "id": "edit-password",
          "selector": "#password",
          "mode": "fill",
          "value": "changed secret"
        }
      ]
    },
    {
      "id": "textarea",
      "source": "<div><label for=\"notes\">Notes</label> <textarea id=\"notes\" placeholder=\"Write notes\">first\nsecond &amp; third</textarea></div>\n<div><label for=\"custom\">Larger notes</label> <textarea id=\"custom\" rows=\"3\" cols=\"24\" maxlength=\"20\">initial</textarea></div>",
      "actions": [
        {
          "id": "edit-lines",
          "selector": "#notes",
          "mode": "fill",
          "value": "alpha\nbeta\ngamma"
        },
        {
          "id": "limit-textarea",
          "selector": "#custom",
          "mode": "fill",
          "value": "abcdefghijklmnopqrstuvwxyz"
        },
        {
          "id": "replace-document",
          "mode": "replace-markdown",
          "source": "<div><label for=\"notes\">Notes</label> <textarea id=\"notes\">replacement default</textarea></div>"
        }
      ]
    },
    {
      "id": "constraints",
      "source": "<div><label for=\"limited\">Limited</label> <input id=\"limited\" maxlength=\"5\" minlength=\"3\" required placeholder=\"Up to five\"></div>\n<div><label for=\"readonly\">Read only</label> <input id=\"readonly\" readonly value=\"Keep me\"></div>\n<div><label for=\"disabled\">Disabled</label> <input id=\"disabled\" disabled value=\"Unavailable\"></div>",
      "actions": [
        {
          "id": "limit-input",
          "selector": "#limited",
          "mode": "fill",
          "value": "abcdefgh"
        },
        {
          "id": "insert-at-limit",
          "selector": "#limited",
          "mode": "insert",
          "start": 2,
          "end": 2,
          "value": "Z"
        },
        {
          "id": "replace-at-limit",
          "selector": "#limited",
          "mode": "insert",
          "start": 1,
          "end": 3,
          "value": "XYZ"
        },
        {
          "id": "focus-readonly",
          "selector": "label[for=readonly]"
        },
        {
          "id": "readonly-typing",
          "selector": "#readonly",
          "mode": "key",
          "key": "X"
        },
        {
          "id": "disabled-label",
          "selector": "label[for=disabled]",
          "mode": "dom-click"
        }
      ]
    },
    {
      "id": "labels-and-fieldset",
      "source": "<fieldset disabled><legend><label>Legend <input id=\"legend\" value=\"Enabled\"></label></legend><label for=\"blocked\">Blocked</label><input id=\"blocked\" value=\"Disabled by fieldset\"></fieldset>\n<div><label id=\"wrapped-label\">Wrapped <input id=\"wrapped\" aria-label=\"Explicit name\" aria-describedby=\"help\" value=\"Nested\"></label><span id=\"help\">A hint</span></div>\n<p id=\"duplicate\">First ID belongs to text</p><label for=\"duplicate\" id=\"duplicate-label\">No target</label><input id=\"duplicate\" value=\"Duplicate input\">\n<div hidden><input id=\"hidden-parent\" value=\"Hidden\"></div>",
      "actions": [
        {
          "id": "legend-label",
          "selector": "legend label"
        },
        {
          "id": "edit-legend",
          "selector": "#legend",
          "mode": "fill",
          "value": "Editable in legend"
        },
        {
          "id": "wrapped-label",
          "selector": "#wrapped-label"
        },
        {
          "id": "duplicate-label",
          "selector": "#duplicate-label",
          "mode": "dom-click"
        }
      ]
    },
    {
      "id": "number",
      "source": "<div><label for=\"quantity\">Quantity</label> <input id=\"quantity\" type=\"number\" min=\"0\" max=\"2\" step=\"0.25\" value=\"1.3\"></div>\n<div><label for=\"exponent\">Exponent</label> <input id=\"exponent\" type=\"number\" min=\"-200\" max=\"200\" step=\"any\" value=\"-1.25e1\"></div>\n<div><label for=\"invalid\">Invalid default</label> <input id=\"invalid\" type=\"number\" value=\"1.\"></div>\n<div><label for=\"default\">Default increment</label> <input id=\"default\" type=\"number\"></div>",
      "actions": [
        {
          "id": "step-up-off-grid",
          "selector": "#quantity",
          "mode": "key",
          "key": "ArrowUp"
        },
        {
          "id": "edit-over-max",
          "selector": "#quantity",
          "mode": "fill",
          "value": "3"
        },
        {
          "id": "step-back-into-range",
          "selector": "#quantity",
          "mode": "key",
          "key": "ArrowDown"
        },
        {
          "id": "edit-signed-decimal",
          "selector": "#exponent",
          "mode": "fill",
          "value": "-12.5"
        },
        {
          "id": "step-any",
          "selector": "#exponent",
          "mode": "key",
          "key": "ArrowUp"
        },
        {
          "id": "edit-under-min",
          "selector": "#exponent",
          "mode": "fill",
          "value": "-300"
        },
        {
          "id": "step-up-from-underflow",
          "selector": "#exponent",
          "mode": "key",
          "key": "ArrowUp"
        },
        {
          "id": "default-step-up",
          "selector": "#default",
          "mode": "key",
          "key": "ArrowUp"
        },
        {
          "id": "default-step-down",
          "selector": "#default",
          "mode": "key",
          "key": "ArrowDown"
        }
      ]
    }
  ]
}
